{
  "name": "heritagefund",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "mobile": "cd apps/mobile && npm run start",
    "web": "cd apps/web && npm run dev"
  },
  "devDependencies": {
    "turbo": "^1.11.2",
    "prettier": "^3.1.1"
  },
  "packageManager": "npm@10.2.5",
  "engines": {
    "node": ">=18.0.0"
  }
}
